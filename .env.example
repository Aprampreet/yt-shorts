# Local: export these values in every API/worker/beat terminal, or use Docker Compose. Secrets stay empty here.

# ---- Django / infrastructure ------------------------------------------------------------------------------
# Debug mode; keep true only on a local machine.
DJANGO_DEBUG=true
# Django secret key; set a long random value outside local development.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated host names the API accepts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed to call the API (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Redis broker for Celery.
REDIS_URL=redis://localhost:6379/0
# Route tasks to media/ai/publish queues (default false). Enable only when your workers run with -Q (see README).
# Docker Compose enables it unless this variable is set, because it starts matching workers.
# CELERY_SEPARATE_QUEUES=true
# Soft time limit in seconds for story AI tasks (analyse/write/narrate).
# AI_TASK_SOFT_TIME_LIMIT=600
# SQLite journal mode (wal lets the API read while workers write). Use delete on network filesystems.
# SQLITE_JOURNAL_MODE=wal
# Optional PostgreSQL: install psycopg[binary] and set DATABASE_URL.
# DATABASE_URL=postgresql://studio:password@db:5432/studio
# Where uploads, renders and assets are stored (default backend/media).
# MEDIA_ROOT=/absolute/path/to/media

# ---- Limits and retention ---------------------------------------------------------------------------------
# Longest source video accepted, in seconds.
MAX_SOURCE_DURATION=1800
# Largest source upload accepted, in bytes.
MAX_SOURCE_BYTES=524288000
# Free disk space (bytes) that must remain before a job may start.
MAX_DISK_BYTES=5368709120
# Seconds allowed for a source download.
DOWNLOAD_TIMEOUT=600
# Seconds allowed for a single FFmpeg/whisper process.
PROCESS_TIMEOUT=600
# Seconds allowed for a whole job before the worker stops it.
JOB_TIMEOUT=3600
# Days source footage is kept after a job finishes (run cleanup_studio on a schedule; see README).
SOURCE_RETENTION_DAYS=1
# Days finished outputs and their job folders are kept.
OUTPUT_RETENTION_DAYS=7
# Longest narration, in seconds, accepted for a story script.
# NARRATION_MAX_SECONDS=600

# ---- AI spending policy -----------------------------------------------------------------------------------
# Paid/metered hosted inference stays off unless AI_ALLOW_PAID_PROVIDERS=true.
AI_ALLOW_PAID_PROVIDERS=false
# Legacy name for the same switch; still honoured. Set true only after deliberately authorising inference charges.
AI_ALLOW_BILLABLE=false
# Free-tier providers (e.g. a free Groq account) are allowed by default; set false to use local providers only.
AI_ALLOW_FREE_TIER=true
# Daily USD ceiling for providers with a known price. 0 blocks every priced call.
AI_DAILY_BUDGET_USD=0
# Seconds before a hosted request is abandoned.
AI_REQUEST_TIMEOUT=45
# Retries for a failed hosted request.
AI_MAX_RETRIES=2
# Hosted inference requests allowed per job.
AI_MAX_CALLS_PER_JOB=30
# Optional free-tier daily call cap per provider (0 = no app-side cap; providers still enforce their own limits).
# AI_FREE_TIER_DAILY_CALLS=0
# Optional daily cap on paid/metered calls across providers (0 = no cap beyond AI_MAX_CALLS_PER_JOB).
# AI_DAILY_PAID_CALLS=0
# Cooldown applied after a 429 without a usable Retry-After header.
# AI_RATE_LIMIT_COOLDOWN_SECONDS=60
# Provider order per capability (comma separated; names left out are disabled for that capability).
# AI_PROVIDER_ORDER_ASR=local_whisper,groq,huggingface
# AI_PROVIDER_ORDER_TEXT=groq,gemini,huggingface
# AI_PROVIDER_ORDER_VISION=groq,gemini
# AI_PROVIDER_ORDER_TRANSLATION=huggingface
# AI_PROVIDER_ORDER_TTS=manual

# ---- Local transcription ----------------------------------------------------------------------------------
# Offline captions: the default model path is backend/.local/models/ggml-base-q5_1.bin.
# Path to the whisper.cpp binary (brew install whisper-cpp).
# LOCAL_WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# Absolute path to a multilingual ggml model file.
# LOCAL_WHISPER_MODEL=/absolute/path/to/ggml-base-q5_1.bin

# ---- Hugging Face (opt-in; free accounts have no inference credits) ---------------------------------------
# Access token.
HF_TOKEN=
# Inference provider routing for Hugging Face.
HF_PROVIDER=auto
# Model ids; no defaults, choose ones your account can use.
HF_TRANSCRIPTION_MODEL=
HF_TEXT_MODEL=
HF_TRANSLATION_MODEL=

# ---- Groq (optional metadata, vision and higher-accuracy clip captions) -----------------------------------
# Keep the key in a local .env only.
GROQ_API_KEY=
# Master switch for Groq.
GROQ_ENABLED=true
# Chat model for metadata and story text.
GROQ_TEXT_MODEL=openai/gpt-oss-20b
# Speech-to-text model.
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
# Vision model (preview).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Groq Orpheus TTS (English only, preview, small free allowance). Uses GROQ_API_KEY.
GROQ_TTS_MODEL=

# ---- Google Gemini (AI Studio key) ------------------------------------------------------------------------
# Free tier: prompts may be used to improve Google products and read by human reviewers; not permitted for
# serving end users in the EEA, UK or Switzerland. A key on a billing-enabled project is billed.
GEMINI_API_KEY=
# Master switch for Gemini.
GEMINI_ENABLED=true
# Model ids have no default: pick current free-tier Flash / Flash-Lite ids from the Gemini docs.
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=
# TTS model id from the Gemini API model list.
GEMINI_TTS_MODEL=

# ---- ElevenLabs (paid, opt-in) ----------------------------------------------------------------------------
# Also needs AI_ALLOW_PAID_PROVIDERS=true and AI_DAILY_BUDGET_USD above 0.
# ELEVENLABS_API_KEY=
# TTS model id.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Set true only if your ElevenLabs plan includes a commercial licence (the free plan does not).
# ELEVENLABS_PLAN_COMMERCIAL=false
# Voice ids to offer in the UI as id:Label,id:Label
# ELEVENLABS_VOICES=

# ---- Rendering and editing --------------------------------------------------------------------------------
# Optional explicit FFmpeg binaries. Apple Silicon ffmpeg-full is auto-detected.
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# Caption renderer: auto (libass if available, else PNG overlays), ass (requires libass) or png.
CAPTION_RENDERER=auto
# Font file (.ttf/.ttc) that overrides the bundled caption fonts for every script.
# CAPTION_FONT_PATH=/absolute/path/to/font.ttf
# Font family used for Devanagari in libass captions.
# CAPTION_FONT_DEVANAGARI=Arial Unicode MS
# Weight (0 to 1) of the unofficial most-replayed signal in highlight scoring.
# REPLAY_WEIGHT=0.15
# JSON object overriding all eight highlight signal weights (see services/analysis.py).
# HIGHLIGHT_WEIGHTS=

# ---- Publishing: YouTube and Instagram --------------------------------------------------------------------
# Social OAuth is unavailable until configured with your own official apps.
# Key (Fernet) used to encrypt stored OAuth tokens; generate your own.
SOCIAL_ENCRYPTION_KEY=
# Browser origin the OAuth callbacks send you back to.
SOCIAL_FRONTEND_URL=http://localhost:5173
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/youtube/callback
# Instagram Reels publishing (official Instagram API with Instagram Login). Needs a Meta app and a professional account.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/instagram/callback
# Instagram fetches the video from a PUBLIC https URL. Expose only MEDIA_ROOT/public_reels at this address.
# PUBLIC_MEDIA_BASE_URL=https://media.example.com/public_reels
# Graph API version to call.
# INSTAGRAM_GRAPH_VERSION=v27.0
# Seconds to wait for Instagram to finish processing an upload, and the polling interval.
# INSTAGRAM_POLL_TIMEOUT=300
# INSTAGRAM_POLL_INTERVAL=15
