# Local: export these values in every API/worker terminal, or use Docker Compose.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
REDIS_URL=redis://localhost:6379/0
# Route tasks to media/ai/publish queues (default false). Enable only when your workers run with -Q (see README).
# Docker Compose enables it unless this variable is set, because it starts matching workers.
# CELERY_SEPARATE_QUEUES=true
# AI_TASK_SOFT_TIME_LIMIT=600
# SQLite journal mode (wal lets the API read while workers write). Use delete on network filesystems.
# SQLITE_JOURNAL_MODE=wal
# Optional PostgreSQL: install psycopg[binary] and set DATABASE_URL.
# DATABASE_URL=postgresql://studio:password@db:5432/studio
# Provider spending policy. Paid/metered hosted inference stays off unless AI_ALLOW_PAID_PROVIDERS=true.
# AI_ALLOW_BILLABLE is the legacy name for the same switch and is still honoured.
AI_ALLOW_PAID_PROVIDERS=false
AI_ALLOW_BILLABLE=false
# Free-tier providers (e.g. a free Groq account) are allowed by default; set false to use local providers only.
AI_ALLOW_FREE_TIER=true
# Daily USD ceiling for providers with a known price. 0 blocks every priced call.
AI_DAILY_BUDGET_USD=0
HF_TOKEN=
HF_PROVIDER=auto
HF_TRANSCRIPTION_MODEL=
# Offline captions: the default model path is backend/.local/models/ggml-base-q5_1.bin.
# LOCAL_WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# LOCAL_WHISPER_MODEL=/absolute/path/to/ggml-base-q5_1.bin
HF_TEXT_MODEL=
HF_TRANSLATION_MODEL=
# Optional Groq metadata and higher-accuracy clip captions. Keep the key in local .env only.
GROQ_API_KEY=
GROQ_ENABLED=true
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
AI_MAX_CALLS_PER_JOB=30
# Provider layer (GET /api/v1/providers shows each provider's status and reason).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Google Gemini API (AI Studio key). Free tier: prompts may be used to improve Google products and read by
# human reviewers; not permitted for serving end users in the EEA, UK or Switzerland. A key on a billing-enabled
# project is billed. Model IDs have no default: pick current free-tier Flash / Flash-Lite IDs from the Gemini docs.
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=
# Optional free-tier daily call cap per provider (0 = no app-side cap; providers still enforce their own limits).
# AI_FREE_TIER_DAILY_CALLS=0
# Optional daily cap on paid/metered calls across providers (0 = no cap beyond AI_MAX_CALLS_PER_JOB).
# AI_DAILY_PAID_CALLS=0
# Cooldown applied after a 429 without a usable Retry-After header.
# AI_RATE_LIMIT_COOLDOWN_SECONDS=60
# Provider order per capability (comma separated; names left out are disabled for that capability).
# AI_PROVIDER_ORDER_ASR=local_whisper,groq,huggingface
# AI_PROVIDER_ORDER_TEXT=groq,gemini,huggingface
# AI_PROVIDER_ORDER_VISION=groq,gemini
# AI_PROVIDER_ORDER_TRANSLATION=huggingface
# AI_PROVIDER_ORDER_TTS=manual
MAX_SOURCE_DURATION=1800
MAX_SOURCE_BYTES=524288000
MAX_DISK_BYTES=5368709120
DOWNLOAD_TIMEOUT=600
PROCESS_TIMEOUT=600
JOB_TIMEOUT=3600
SOURCE_RETENTION_DAYS=1
OUTPUT_RETENTION_DAYS=7
# Optional explicit FFmpeg binaries. Apple Silicon ffmpeg-full is auto-detected.
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# Social OAuth is unavailable until configured with your own official app.
SOCIAL_ENCRYPTION_KEY=
SOCIAL_FRONTEND_URL=http://localhost:5173
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/youtube/callback
# Set only after deliberately authorizing potential inference charges.
# AI_ALLOW_BILLABLE=true
# CAPTION_FONT_DEVANAGARI=Arial Unicode MS
# Instagram Reels publishing (official Instagram API with Instagram Login). Needs a Meta app and a professional account.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/instagram/callback
# Instagram fetches the video from a PUBLIC https URL. Expose only MEDIA_ROOT/public_reels at this address.
# PUBLIC_MEDIA_BASE_URL=https://media.example.com/public_reels
# INSTAGRAM_GRAPH_VERSION=v27.0
# INSTAGRAM_POLL_TIMEOUT=300
# INSTAGRAM_POLL_INTERVAL=15

# Narration / text-to-speech. Hosted providers are off until configured; manual narration upload always works.
# Gemini TTS (free tier; content may be used by Google and seen by reviewers; not for serving EEA/UK/Swiss users).
# Uses GEMINI_API_KEY plus a TTS model id from the Gemini API model list:
GEMINI_TTS_MODEL=
# Groq Orpheus (English only, preview, small free allowance). Uses GROQ_API_KEY:
GROQ_TTS_MODEL=
# ElevenLabs is PAID and opt-in: also needs AI_ALLOW_PAID_PROVIDERS=true and AI_DAILY_BUDGET_USD above 0.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Set true only if your ElevenLabs plan includes a commercial licence (the free plan does not).
# ELEVENLABS_PLAN_COMMERCIAL=false
# Voice ids to offer in the UI as id:Label,id:Label
# ELEVENLABS_VOICES=
# NARRATION_MAX_SECONDS=600
