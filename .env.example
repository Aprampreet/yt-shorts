# Local: export these values in every API/worker terminal, or use Docker Compose.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
REDIS_URL=redis://localhost:6379/0
# Optional PostgreSQL: install psycopg[binary] and set DATABASE_URL.
# DATABASE_URL=postgresql://studio:password@db:5432/studio
AI_ALLOW_BILLABLE=false
HF_TOKEN=
HF_PROVIDER=auto
HF_TRANSCRIPTION_MODEL=
# Offline captions: the default model path is backend/.local/models/ggml-base-q5_1.bin.
# LOCAL_WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# LOCAL_WHISPER_MODEL=/absolute/path/to/ggml-base-q5_1.bin
HF_TEXT_MODEL=
HF_TRANSLATION_MODEL=
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
AI_MAX_CALLS_PER_JOB=30
MAX_SOURCE_DURATION=1800
MAX_SOURCE_BYTES=524288000
MAX_DISK_BYTES=5368709120
DOWNLOAD_TIMEOUT=600
PROCESS_TIMEOUT=600
JOB_TIMEOUT=3600
SOURCE_RETENTION_DAYS=1
OUTPUT_RETENTION_DAYS=7
# Optional explicit FFmpeg binaries. Apple Silicon ffmpeg-full is auto-detected.
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# Social OAuth is unavailable until configured with your own official app.
SOCIAL_ENCRYPTION_KEY=
SOCIAL_FRONTEND_URL=http://localhost:5173
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/youtube/callback
# Set only after deliberately authorizing potential inference charges.
# AI_ALLOW_BILLABLE=true
# CAPTION_FONT_DEVANAGARI=Arial Unicode MS
